{
  "builds": [
    {
      "src": "latex_generator/api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "latex_generator/frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "latex_generator/api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "latex_generator/frontend/$1"
    }
  ]
}
